{
  "activationEvents": [
    "onView:awino.chat"
  ],
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "contributes": {
    "commands": [
      {
        "command": "awino.newMission",
        "title": "Awino: New Mission"
      },
      {
        "command": "awino.newMissionFromSeed",
        "title": "Awino: New Mission from Seed"
      },
      {
        "command": "awino.saveSeed",
        "title": "Awino: Save Current Mission as Seed"
      },
      {
        "command": "awino.inspectContract",
        "title": "Awino: Inspect Contract"
      },
      {
        "command": "awino.approveContract",
        "title": "Awino: Approve Contract"
      },
      {
        "command": "awino.rollback",
        "title": "Awino: Rollback"
      },
      {
        "command": "awino.housekeep",
        "title": "Awino: Housekeep Project"
      },
      {
        "command": "awino.doctor",
        "title": "Awino: Doctor Project"
      },
      {
        "command": "awino.addSkill",
        "title": "Awino: Add Skill"
      },
      {
        "command": "awino.addContext",
        "title": "Awino: Add Context File"
      },
      {
        "command": "awino.removeContext",
        "title": "Awino: Remove Context File"
      },
      {
        "command": "awino.setApiKey",
        "title": "Awino: Set API Key"
      },
      {
        "command": "awino.clearApiKey",
        "title": "Awino: Clear API Key"
      },
      {
        "command": "awino.invokeMode",
        "title": "Awino: Invoke Mode"
      },
      {
        "command": "awino.dismissMode",
        "title": "Awino: Dismiss Mode (back to stage default)"
      },
      {
        "command": "awino.assumePersona",
        "title": "Awino: Assume Skill as Persona"
      },
      {
        "command": "awino.dismissPersona",
        "title": "Awino: Dismiss Persona"
      },
      {
        "command": "awino.switchEnvironment",
        "title": "Awino: Switch Environment"
      },
      {
        "command": "awino.reconnect",
        "title": "Awino: Reconnect Sidecar"
      },
      {
        "command": "awino.refreshViews",
        "title": "Awino: Refresh Views"
      },
      {
        "command": "awino.openModels",
        "title": "Awino: Models & Providers"
      },
      {
        "command": "awino.setupBedrock",
        "title": "Awino: Set Up AWS Bedrock"
      },
      {
        "command": "awino.importConnections",
        "title": "Awino: Import connections from other tools"
      }
    ],
    "configuration": {
      "properties": {
        "awino.endpoint": {
          "default": "",
          "description": "OpenAI-compatible base URL or Anthropic base URL. Empty = provider default.",
          "type": "string"
        },
        "awino.mcpServers": {
          "default": [],
          "description": "MCP servers the sidecar spawns over stdio. Each: {name, command, args?, env?}. Their tools enter the harness registry under the same contract and approval gates.",
          "items": {
            "properties": {
              "args": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "command": {
                "type": "string"
              },
              "env": {
                "type": "object"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "command"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "awino.model": {
          "default": "",
          "description": "Model name. Empty = provider default.",
          "type": "string"
        },
        "awino.provider": {
          "default": "echo",
          "description": "Model source for the harness. API keys are NOT stored here — use 'Awino: Set API Key'.",
          "enum": [
            "echo",
            "ollama",
            "openai",
            "anthropic",
            "bedrock"
          ],
          "type": "string"
        },
        "awino.bedrockRegion": {
          "default": "",
          "description": "AWS region for the Bedrock provider. The OpenAI-compatible endpoint is derived from it (https://bedrock-runtime.{region}.amazonaws.com/openai/v1); awino.endpoint overrides it when set.",
          "type": "string"
        },
        "awino.pythonPath": {
          "default": "python3",
          "description": "Python interpreter used to launch the Awino sidecar.",
          "type": "string"
        },
        "awino.script": {
          "default": null,
          "description": "TEST ONLY: scripted candidate turns for the scripted provider (set awino.provider to \"scripted\"). Each turn goes through the identical validation/judge/approval pipeline — it only feeds candidate turns instead of calling a model. Leave empty in normal use.",
          "items": {
            "type": "object"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "awino.timeout": {
          "default": 180,
          "description": "Model HTTP timeout in seconds.",
          "type": "number"
        }
      },
      "title": "Awino"
    },
    "views": {
      "awino": [
        {
          "id": "awino.chat",
          "name": "Mission Chat",
          "type": "webview"
        },
        {
          "id": "awino.contract",
          "name": "Contract"
        },
        {
          "id": "awino.journal",
          "name": "Journal"
        },
        {
          "id": "awino.learnings",
          "name": "Learnings"
        },
        {
          "id": "awino.skills",
          "name": "Skills"
        },
        {
          "id": "awino.context",
          "name": "Context"
        },
        {
          "id": "awino.modes",
          "name": "Modes"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "icon": "resources/awino.svg",
          "id": "awino",
          "title": "Awino"
        }
      ]
    },
    "viewsWelcome": [
      {
        "contents": "No sidecar connected.\nOpen a workspace folder and the Awino sidecar will start automatically.\n[Open Folder](command:vscode.openFolder)",
        "view": "awino.chat"
      }
    ]
  },
  "description": "Own the loop",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  },
  "displayName": "Awino",
  "engines": {
    "vscode": "^1.85.0"
  },
  "keywords": [
    "awino",
    "agent",
    "mission",
    "harness",
    "llm"
  ],
  "license": "SEE LICENSE IN REPOSITORY",
  "main": "./out/extension.js",
  "name": "awino-loop-owner",
  "publisher": "lukematic",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lukematic/harness-awino"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "test": "node ./test/harness.js && node ./test/bedrock.js && node ./test/connection_importer.js",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile && node ./scripts/bundle-sidecar.js"
  },
  "version": "0.3.0"
}
